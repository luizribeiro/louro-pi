#!/usr/bin/env bash
set -euo pipefail

src="${LOURO_PI_SRC:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)}"

: "${LITELLM_API_KEY:?LITELLM_API_KEY must be set}"
LOURO_BIN="$(command -v "${LOURO_BIN:-louro}")"
export LOURO_BIN

run="$(mktemp -d)"
trap 'rm -rf "$run"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

connect_louro() {
  local fifo="$run/password"
  local password
  password="$(sops decrypt --extract '["password"]' "$src/secrets/louro.yaml")"
  mkfifo -m 600 "$fifo"
  printf '%s' "$password" >"$fifo" &
  unset password
  local status=0
  (cd "$run" && env -u LITELLM_API_KEY "$LOURO_BIN" connect --config "$src/louro.toml") || status=$?
  kill $! 2>/dev/null || true
  rm -f "$fifo"
  return "$status"
}

louro_is_down() {
  local status=0
  env -u LITELLM_API_KEY "$LOURO_BIN" status >/dev/null || status=$?
  [[ $status -eq 3 ]]
}

louro_is_down && connect_louro
rm -rf "$run"
exec node "$src/src/main.ts"
