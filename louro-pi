#!/usr/bin/env bash
set -euo pipefail

src="${LOURO_PI_SRC:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)}"

: "${LITELLM_API_KEY:?LITELLM_API_KEY must be set}"
if grep -q @filter@ "$src/louro.toml"; then
  echo "louro-pi: louro.toml has no outgoing filter yet; run the built app with \`nix run .#\`" >&2
  exit 1
fi
LOURO_BIN="$(command -v "${LOURO_BIN:-louro}")"
export LOURO_BIN

run="$(mktemp -d)"
trap 'rm -rf "$run"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

decrypt_password() {
  local gpg_timeout="${LOURO_PI_GPG_TIMEOUT:-5}"
  echo "louro-pi: decrypting the bot's password; GPG may ask for your passphrase (waiting ${gpg_timeout}s)" >&2
  local status=0
  timeout "$gpg_timeout" sops decrypt --extract '["password"]' "$src/secrets/louro.yaml" || status=$?
  if [[ $status -eq 124 ]]; then
    echo "louro-pi: gave up waiting for GPG after ${gpg_timeout}s; is the passphrase prompt hidden behind a window?" >&2
  fi
  return "$status"
}

connect_louro() {
  local fifo="$run/password"
  local password
  password="$(decrypt_password)"
  mkfifo -m 600 "$fifo"
  printf '%s' "$password" >"$fifo" &
  unset password
  local status=0
  (cd "$run" && env -u LITELLM_API_KEY "$LOURO_BIN" connect --config "$src/louro.toml") || status=$?
  kill $! 2>/dev/null || true
  rm -f "$fifo"
  return "$status"
}

louro_is_down() {
  local errors status=0
  errors="$(env -u LITELLM_API_KEY "$LOURO_BIN" status 2>&1 >/dev/null)" || status=$?
  case $status in
    0) return 1 ;;
    3) return 0 ;;
    *)
      [[ -n $errors ]] && echo "$errors" >&2
      echo "louro-pi: \`louro status\` failed with exit $status" >&2
      exit "$status"
      ;;
  esac
}

louro_is_down && connect_louro
rm -rf "$run"
exec node "$src/src/main.ts"
