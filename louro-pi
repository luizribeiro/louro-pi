#!/usr/bin/env bash
set -euo pipefail

src="${LOURO_PI_SRC:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)}"

: "${LITELLM_API_KEY:?LITELLM_API_KEY must be set}"
LOURO_BIN="$(command -v "${LOURO_BIN:-louro}")"
export LOURO_BIN

run="$(mktemp -d)"
trap 'rm -rf "$run"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
export PI_CODING_AGENT_DIR="$run/agent"

install_agent_config() {
  mkdir -p "$PI_CODING_AGENT_DIR"
  cp "$src/agent/settings.json" "$src/agent/models.json" "$PI_CODING_AGENT_DIR/"
  chmod u+w "$PI_CODING_AGENT_DIR"/*.json
}

connect_louro() {
  local fifo=password
  local password
  password="$(sops decrypt --extract '["password"]' "$src/secrets/louro.yaml")"
  mkfifo -m 600 "$fifo"
  printf '%s' "$password" >"$fifo" &
  unset password
  local status=0
  "$LOURO_BIN" connect --config "$src/louro.toml" || status=$?
  kill $! 2>/dev/null || true
  rm -f "$fifo"
  return "$status"
}

louro_is_down() {
  local status=0
  "$LOURO_BIN" status >/dev/null || status=$?
  [[ $status -eq 3 ]]
}

install_agent_config
cd "$run"
louro_is_down && connect_louro
while true; do
  pi \
    --mode json -p \
    --no-session \
    --no-builtin-tools --tools louro \
    --no-extensions -e "$src/extensions/louro.ts" \
    --no-skills --no-prompt-templates --no-themes --no-context-files --no-approve \
    --system-prompt "$(cat "$src/SYSTEM.md")" \
    "$@" \
    "louro is connected to irc.weblounge.org as louro. Run \`louro --help\`, then watch your channels and DMs and answer people who talk to you." |
    jq -r --unbuffered -f "$src/live.jq" || true
  echo "pi stopped; restarting in 10s (Ctrl-C to quit)" >&2
  sleep 10
done
